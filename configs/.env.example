# 템플릿 파일입니다.
# 필요한 변수 이름과 형식만 보여주고 값은 replace_me 같은 더미값을 넣습니다. Git에 올려서 팀원이 복사해 사용합니다.

# --- Database ---
DB_NAME=youth_db
DB_USER=youth_admin
DB_PASSWORD=change_me
DB_HOST=db
DB_PORT=5432

# --- API ---
API_PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME=Youth Asset Manager

# --- Security ---
SECRET_KEY=replace_with_a_long_random_secret

# --- External APIs ---
GOV_API_KEY=replace_me
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_DEFAULT_REGION=ap-northeast-2
SERPER_API_KEY=replace_me
GOOGLE_API_KEY=replace_me
